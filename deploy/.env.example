# Copier en deploy/.env sur le serveur puis remplacer chaque valeur.
# Ne jamais versionner le fichier .env.

# Domaine public du CRM (À confirmer)
DOMAIN=crm.redseabunkering.com
APP_PUBLIC_URL=https://crm.redseabunkering.com
CORS_ALLOWED_ORIGINS=https://crm.redseabunkering.com
TZ=Africa/Djibouti

# Base de données
POSTGRES_DB=rsbcrm
POSTGRES_USER=rsbcrm
POSTGRES_PASSWORD=change-me-strong-password

# JWT (>= 256 bits, ex. : openssl rand -base64 48)
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Premier administrateur (créé seulement si aucun admin n'existe)
APP_ADMIN_EMAIL=admin@redseabunkering.com
APP_ADMIN_PASSWORD=change-me-Admin-2026

# Comptes
APP_SIGNUP_REQUIRES_APPROVAL=true

# Données de démonstration : false en production réelle
APP_SEED_DEMO=false
APP_DEMO_PASSWORD=

# Formulaire public du site (snippet WordPress)
# Sans clé API, le formulaire est fermé. Sans CAPTCHA_SECRET, il n'a pas de captcha : à éviter en production.
APP_PUBLIC_LEAD_API_KEY=change-me-random-key
# Cloudflare Turnstile (compte À confirmer)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
PUBLIC_FORM_ALLOWED_ORIGINS=https://redseabunkering.com,https://www.redseabunkering.com

# SMTP (fournisseur À confirmer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=crm@redseabunkering.com
